node_modules/
data/
.env
.wrangler/

# Database dumps from `npm run db:export`. Parish rows carry clergy names,
# emails and phone numbers, and the file is large and quickly stale — keep it
# out of the repo and put it somewhere you control instead.
backups/

# Cached HTTP responses from a directory scrape (scripts/scrape-*.mjs). Caching
# every response on the first fetch is what makes the parsing iterative at a
# cost to the site of one pass — but the bodies are large, quickly stale, and
# carry clergy contact details, so they stay out of the repo. Re-fetch instead.
cache/

# The intermediate files a directory scrape writes (scraped -> geocoded -> .sql).
# Regenerable from the scripts and the cache, and they carry the clergy emails
# and phone numbers a parish directory publishes — the same reason `backups/` is
# here. The ROCOR run's equivalents were never committed either.
/*-scraped.json
/*-geocoded.json
/*-parishes.sql
/*-schedules.sql

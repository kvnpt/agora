{
  "name": "agora",
  "version": "2.0.0",
  "description": "Orthodox Event Finder for Oceania",
  "type": "commonjs",
  "scripts": {
    "dev": "wrangler dev --local --var AGORA_DEV_ADMIN:true",
    "test": "node --test worker/lib/*.test.mjs",
    "deploy": "wrangler deploy",
    "db:schema": "wrangler d1 execute agora --remote --file=d1/schema.sql",
    "db:seed": "wrangler d1 execute agora --remote --file=d1/seed-parishes.sql",
    "gen:seed": "node scripts/gen-seed-sql.js && node scripts/sql-for-console.js"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "better-sqlite3": "^11.8.1",
    "wrangler": "^4.129.0"
  }
}
